#!/bin/bash
# FN-API: delete an Xray account from every transport that holds it.
# Body: {"username":"alice"}
. /usr/local/lib/fn-api/lib.sh
require username user
esc="$(re_escape "$user")"

seen=""
deleted=""
for t in ws upgrade xhttp grpc; do
    json="/etc/xray/json/${t}.json"
    core="$t"
    [ "$t" = upgrade ] && core="http"          # the name the create endpoints accept
    grep -qE "^### ${esc}( |$)" "$json" 2>/dev/null || continue
    seen="$seen $core"
    case $t in
        ws)      printf '%s\n' "$user" | /usr/bin/delete-ws    >/dev/null 2>&1 ;;
        upgrade) printf '%s\n' "$user" | /usr/bin/delete-http  >/dev/null 2>&1 ;;
        xhttp)   printf '%s\n' "$user" | /usr/bin/delete-xhttp >/dev/null 2>&1 ;;
        grpc)    printf '%s\n' "$user" | /usr/bin/delete-grpc  >/dev/null 2>&1 ;;
    esac
    # Verify, like add-xray and delete-ssh do; a delete script that failed must
    # not be reported as a successful removal.
    grep -qE "^### ${esc}( |$)" "$json" 2>/dev/null && continue
    deleted="$deleted $core"
done

[ -n "$seen" ] || fail "no such account: ${user}"
[ -n "$deleted" ] || fail "failed to delete '${user}' from:${seen}"
# Honest partial report: the account lived on transports that would not
# delete. A caller that only reads "status" must still see it did not
# fully go away.
missing=""
for c in $seen; do
    case " $deleted " in *" $c "*) ;; *) missing="$missing $c";; esac
done
if [ -n "$missing" ]; then
    jq -nc --arg u "$user" --arg t "${deleted# }" --arg m "${missing# }" \
        '{status:"success",username:$u,deleted_from:($t|split(" ")),partial:true,failed_from:($m|split(" "))}'
else
    jq -nc --arg u "$user" --arg t "${deleted# }" '{status:"success",username:$u,deleted_from:($t|split(" "))}'
fi
