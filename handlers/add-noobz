#!/bin/bash
# FN-API: create a NoobzVPN account. Body: {"username":"alice","password":"pw","expired":30}
. /usr/local/lib/fn-api/lib.sh
require_tool noobzvpns
require username user
require password pass
days="$(field expired 30)"

# Mirror the panel (menu-noobz.sh): 1-16 letters/numbers/underscore, days > 0.
[[ "$user" =~ ^[a-zA-Z0-9_]{1,16}$ ]] || \
    fail "invalid username '${user}': 1-16 letters, numbers and underscore only"
[[ "$days" =~ ^[1-9][0-9]*$ ]] || fail "invalid 'expired' ('${days}'): whole number greater than 0"

# Fail fast on duplicates: noobz_accounts below would match the pre-existing
# entry and claim success for a no-op.
noobz_accounts | grep -qF "$user" && fail "username '${user}' already exists"

if noobzvpns add --help >/dev/null 2>&1; then
    noobzvpns add --password "$pass" --expired "$days" "$user" >/dev/null 2>&1
else
    noobzvpns --add-user "$user" "$pass" >/dev/null 2>&1
    noobzvpns --expired-user "$user" "$days" >/dev/null 2>&1
fi
noobz_accounts | grep -qF "$user" || fail "the panel did not create '${user}'"
jq -nc --arg u "$user" --arg p "$pass" --arg e "$days" '{status:"success",username:$u,password:$p,expired:$e}'
