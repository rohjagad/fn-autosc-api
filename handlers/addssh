#!/bin/bash
# FN-API: create an SSH account.
# Body: {"username":"alice","password":"pw","expired":30,"limit-ip":2}
. /usr/local/lib/fn-api/lib.sh
require_tool addssh
require username user
require password pass
ip="$(field limit-ip 1)"
days="$(field expired 30)"

# Mirror the panel (addssh.sh): quantities are whole numbers > 0.
[[ "$ip" =~ ^[1-9][0-9]*$ ]] || fail "invalid 'limit-ip' ('${ip}'): whole number greater than 0"
[[ "$days" =~ ^[1-9][0-9]*$ ]] || fail "invalid 'expired' ('${days}'): whole number greater than 0"

# Mirror the panel's own rule (addssh.sh): lowercase, start with a letter,
# max 32 chars. Anything else makes the panel re-prompt from an exhausted
# stdin instead of creating, so reject it here with a clear error.
[[ "$user" =~ ^[a-z][a-z0-9_]{0,31}$ ]] || \
    fail "invalid username '${user}': lowercase, start with a letter, letters/numbers/underscore only, max 32 chars"

# Fail fast on duplicates (same reason as add-xray): the verify below would
# match the pre-existing account and claim success for a no-op.
getent passwd "$user" >/dev/null 2>&1 && fail "username '${user}' already exists"

# The panel prompts username, password, limit-ip, expired (days).
out="$(printf '%s\n%s\n%s\n%s\n' "$user" "$pass" "$ip" "$days" | /usr/bin/addssh 2>&1 | strip_ansi)"
getent passwd "$user" >/dev/null 2>&1 || \
    fail "the panel did not create '${user}'$(panel_reason "$out" | sed 's/^/: /')"

exp="$(chage -l "$user" 2>/dev/null | awk -F': ' '/Account expires/{print $2}')"
jq -nc --arg u "$user" --arg p "$pass" --arg e "$exp" --arg t "$out" \
  '{status:"success",username:$u,password:$p,expired:$e,text:$t}'
