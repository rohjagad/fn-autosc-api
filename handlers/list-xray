#!/bin/bash
# FN-API: list every Xray account, with its transport and expiry.
# The transport is reported under the same name the create endpoints accept
# (ws / http / split / grpc), so a caller can feed it straight back into
# add-xray, delete-xray or renew-xray.
. /usr/local/lib/fn-api/lib.sh
{
  for t in ws upgrade split grpc; do
    core="$t"
    [ "$t" = upgrade ] && core="http"
    grep -E '^### ' "/etc/xray/json/${t}.json" 2>/dev/null | awk -v t="$core" '{print $2" "$3" "t}'
  done
} | jq -R -s 'split("\n") | map(select(length>0) | split(" ") | {username:.[0],expired:.[1],transport:.[2]}) | {status:"success",count:length,accounts:.}'
