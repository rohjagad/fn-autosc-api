#!/bin/bash
# FN-API: change an SSH account's password.
# Body: {"username":"alice","password":"newpw"}
# The panel's pwd-ssh both changes the password and rewrites the account card's
# "Password   :" line, so the operator's record stays correct. It reads the new
# password with Go's Scanln, which stops at the first space, so a password with
# whitespace would be silently truncated - reject it instead.
. /usr/local/lib/fn-api/lib.sh
require_tool pwd-ssh
require username user
require password pass

case "$pass" in
    *[[:space:]]*) fail "the panel's password-change tool cannot handle whitespace in a password" ;;
esac

getent passwd "$user" >/dev/null 2>&1 || fail "no such account: ${user}"
before="$(getent shadow "$user" 2>/dev/null | cut -d: -f2)"

printf '%s\n%s\n' "$user" "$pass" | /usr/bin/pwd-ssh >/dev/null 2>&1

after="$(getent shadow "$user" 2>/dev/null | cut -d: -f2)"
[ -n "$after" ] && [ "$after" != "$before" ] || fail "the panel did not change the password for '${user}'"
ok "password changed for ${user}"
