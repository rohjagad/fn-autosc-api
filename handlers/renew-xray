#!/bin/bash
# FN-API: extend an Xray account's expiry.
# Body: {"username":"alice","days":30,"core":"ws|http|split|grpc"}
# The panel's extend-* scripts prompt username, days, then "reset total usage
# quota? (y/n)"; the account's usage is kept (answer n).
. /usr/local/lib/fn-api/lib.sh
require username user
esc="$(re_escape "$user")"
days="$(field days 30)"
core="$(field core ws)"

case "$core" in
    ws)    json=/etc/xray/json/ws.json;      tool=/usr/bin/extend-ws ;;
    http)  json=/etc/xray/json/upgrade.json; tool=/usr/bin/extend-http ;;
    split) json=/etc/xray/json/split.json;   tool=/usr/bin/extend-split ;;
    grpc)  json=/etc/xray/json/grpc.json;    tool=/usr/bin/extend-grpc ;;
    *)     fail "unsupported core '${core}' for renew (use ws, http, split or grpc)" ;;
esac
[ -x "$tool" ] || fail "this panel edition does not ship '${tool##*/}'"

grep -qE "^### ${esc}( |$)" "$json" 2>/dev/null || fail "no such account in '${core}': ${user}"

expiry() { grep -hoE "^### ${esc} [0-9-]+" "$json" 2>/dev/null | awk '{print $3}' | head -1; }
before="$(expiry)"
printf '%s\n%s\n%s\n' "$user" "$days" "n" | "$tool" >/dev/null 2>&1
after="$(expiry)"
[ "$after" != "$before" ] || fail "the panel did not extend '${user}'"

jq -nc --arg u "$user" --arg c "$core" --arg b "$before" --arg e "$after" \
  '{status:"success",username:$u,core:$c,previous_expired:$b,expired:$e}'
