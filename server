#!/usr/bin/env python3
"""FN AutoSC panel HTTP API server.

Self-contained replacement for FN-API's `core/server`, keeping the same
contract so existing clients keep working:

  * API tokens   : one per line in /etc/xray/.key
  * Authorization: the raw header value must equal one of the tokens
  * <METHOD> /<name>  ->  run /usr/bin/rere/<name> with the request body on
    stdin and return its stdout
  * logging      : /etc/xray/api.log

Unlike the reference server this one binds 127.0.0.1 by default (it only has
to be reachable by nginx), accepts a single path segment (no traversal), and
reports a failing handler's stdout alongside the error.

Usage:
    server [--bind 127.0.0.1] [--port 9000]
           [--handlers /usr/bin/rere] [--tokens /etc/xray/.key]
           [--log /etc/xray/api.log]
"""

import argparse
import json
import logging
import logging.handlers
import os
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

METHODS = ("GET", "POST", "DELETE", "PUT", "PATCH", "CONNECT", "TRACE", "HEAD", "OPTIONS")

# Bounds that keep the single thread from wedging. nginx fronts this server
# and buffers full requests, so arrivals here are fast and local; anything
# slower or bigger than below is a stuck or hostile client, not real use.
SOCKET_TIMEOUT = 30       # seconds of socket silence before dropping the conn
MAX_BODY = 1_000_000      # request bodies are small JSON objects; above this, 413
LISTEN_BACKLOG = 64       # TCP accept queue; handling itself stays serial

# The server is single-threaded, like the reference. That is not a limitation to
# improve away: the panel's scripts edit shared state (json/*.json, /etc/passwd,
# the service units) with no locking of their own, so two requests must never run
# them at once - a threaded build lost four of twelve concurrent creates. nginx
# fronts this server and buffers requests, so slow-client handling is its job and
# there is nothing to gain from threading the handler path.


def load_tokens(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return [line.strip() for line in fh if line.strip()]
    except (OSError, ValueError):
        # OSError: missing/unreadable. ValueError (incl. UnicodeDecodeError):
        # binary/garbled file - fail closed with no tokens, never traceback.
        return []


class Handler(BaseHTTPRequestHandler):
    server_version = "fn-autosc-api"
    protocol_version = "HTTP/1.1"
    # Bound a slow-dripping client: with no timeout a single connection can
    # hold rfile.read() (and the whole single thread) forever. nginx already
    # buffers real clients, so this only ever fires on stuck ones.
    timeout = SOCKET_TIMEOUT

    def log_message(self, fmt, *args):  # keep BaseHTTPRequestHandler quiet
        pass

    # ---- helpers ---------------------------------------------------------
    def _info(self, extra=""):
        logging.info("from %s %s \"%s\" %s", self.client_address[0],
                     self.headers.get("User-Agent", "-"), self.path, extra)

    def _send(self, code, body, ctype="application/json", headers=()):
        raw = body if isinstance(body, bytes) else str(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        if self.command != "HEAD":
            try:
                self.wfile.write(raw)
            except (BrokenPipeError, ConnectionResetError):
                # Client went away mid-reply (the OSError branch below already
                # guarded this; extend it to every reply path). The server
                # itself is unaffected.
                pass

    def _unauthorized(self):
        self._send(401, b'{"message": "Unauthorized: Missing or invalid Authorization header"}',
                   headers=[("WWW-Authenticate", 'Token realm="Authentication required"')])
        self._info("unauthorized")
        logging.warning("unauthorized access attempt")

    def _authorized(self):
        tokens = load_tokens(self.server.tokens_path)
        provided = (self.headers.get("Authorization") or "").strip()
        if not provided or provided not in tokens:
            self._unauthorized()
            return False
        return True

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length > MAX_BODY:
            # Refuse before reading: handler bodies are small JSON, and
            # leaving a giant body unread would desync the keep-alive framing.
            # False (not None) tells the do_* caller to skip the handler.
            self.close_connection = True
            self._send(413, json.dumps({"error": "request body too large"}).encode())
            return False
        return self.rfile.read(length).decode("utf-8", "replace") if length > 0 else None

    def _run(self, body=None):
        name = self.path.split("?", 1)[0].strip("/")
        if not name or "/" in name or name in (".", ".."):
            self._info("rejected path")
            self._send(404, b"Script not found")
            return
        script = os.path.join(self.server.handlers_dir, name)
        if not os.path.isfile(script):
            self._info("script not found: %s" % script)
            logging.error("script not found: %s", script)
            self._send(404, b"Script not found")
            return
        if os.path.dirname(os.path.realpath(script)) != os.path.realpath(self.server.handlers_dir):
            # A single-segment name cannot traverse on its own, but a planted
            # symlink inside the handlers dir could point outside it (e.g. at
            # /etc/passwd). The installer's own aliases (add-ss/add-socks ->
            # unsupported) resolve inside the dir, so they still pass.
            self._info("handler escapes directory: %s" % script)
            logging.error("handler escapes directory: %s", script)
            self._send(404, b"Script not found")
            return
        try:
            env = dict(os.environ, TERM="xterm")
            # An empty string, not None: None would let the handler inherit the
            # server's stdin, so a GET handler running the server by hand would
            # block in `cat` instead of seeing EOF.
            result = subprocess.run([script], input=(body if body is not None else ""),
                                    capture_output=True, text=True, check=True,
                                    env=env, timeout=180)
            self._send(200, result.stdout.encode())
            self._info("ok: %s" % script)
        except subprocess.CalledProcessError as exc:
            payload = json.dumps({"error": str(exc),
                                  "stdout": (exc.stdout or "")[:8000]})
            self._send(500, payload.encode())
            self._info("handler failed: %s" % script)
            logging.error("handler failed: %s: %s", script, exc)
        except subprocess.TimeoutExpired:
            self._send(500, json.dumps({"error": "handler timed out"}).encode())
            logging.error("handler timed out: %s", script)
        except OSError as exc:
            # The file passed isfile() but cannot be executed (e.g. a deployed
            # handler lost its +x bit, or it vanished between the check and the
            # exec). Without this the exception escapes do_GET, the connection
            # dies with an empty reply, and the client cannot tell a broken
            # handler from a dead server. The server itself survives either way.
            payload = json.dumps({"error": "cannot execute handler: %s" % exc})
            try:
                self._send(500, payload.encode())
            except (BrokenPipeError, ConnectionResetError):
                pass
            self._info("handler not executable: %s" % script)
            logging.error("handler not executable: %s: %s", script, exc)

    # ---- methods ---------------------------------------------------------
    def do_OPTIONS(self):
        if not self._authorized():
            return
        self._send(200, b'{"message": "OPTIONS request received"}',
                   headers=[("Allow", ", ".join(METHODS))])

    def do_HEAD(self):
        if self._authorized():
            self._run()

    def do_GET(self):
        if self._authorized():
            self._run()

    def do_CONNECT(self):
        if self._authorized():
            self._run()

    def do_TRACE(self):
        if self._authorized():
            self._run()

    def do_POST(self):
        if self._authorized():
            body = self._body()
            if body is not False:
                self._run(body)

    def do_PUT(self):
        if self._authorized():
            body = self._body()
            if body is not False:
                self._run(body)

    def do_PATCH(self):
        if self._authorized():
            body = self._body()
            if body is not False:
                self._run(body)

    def do_DELETE(self):
        if self._authorized():
            body = self._body()
            if body is not False:
                self._run(body)


class Server(HTTPServer):
    # Absorb connection bursts at accept time (handling itself stays serial,
    # like the reference). The default queue of 5 drops bursts that nginx or
    # parallel API clients legitimately produce.
    request_queue_size = LISTEN_BACKLOG

    def __init__(self, addr, handler, handlers_dir, tokens_path):
        super().__init__(addr, handler)
        self.handlers_dir = handlers_dir
        self.tokens_path = tokens_path


def main(argv=None):
    ap = argparse.ArgumentParser(description="FN AutoSC panel HTTP API")
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=9000)
    ap.add_argument("--handlers", default="/usr/bin/rere")
    ap.add_argument("--tokens", default="/etc/xray/.key")
    ap.add_argument("--log", default="/etc/xray/api.log")
    args = ap.parse_args(argv)

    handlers = []
    try:
        # WatchedFileHandler re-opens by path per record, so an external
        # logrotate keeps working instead of silently losing records.
        handlers.append(logging.handlers.WatchedFileHandler(args.log))
    except OSError as exc:                                  # noqa: PERF203
        print("warning: cannot write %s (%s)" % (args.log, exc), file=sys.stderr)
    logging.basicConfig(level=logging.INFO,
                        format="%(asctime)s %(levelname)s %(message)s",
                        handlers=handlers or [logging.StreamHandler()])

    if not load_tokens(args.tokens):
        print("error: no API tokens in %s" % args.tokens, file=sys.stderr)
        return 1
    if not os.path.isdir(args.handlers):
        print("warning: handler directory %s does not exist" % args.handlers, file=sys.stderr)

    srv = Server((args.bind, args.port), Handler, args.handlers, args.tokens)
    logging.info("starting on %s:%d (handlers=%s)", args.bind, args.port, args.handlers)
    print("fn-autosc-api listening on %s:%d" % (args.bind, args.port))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
